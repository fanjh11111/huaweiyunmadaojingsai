# Leave DASHSCOPE_API_KEY empty to run the local fallback answer path.
DASHSCOPE_ENABLED=1
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
# DashScope 请求最长等待 30 秒，正常返回时会立即结束。
DASHSCOPE_TIMEOUT=30
# Same-origin Nginx deployment normally needs no browser CORS entry.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional protection for the external RAG tool endpoint.
RAG_TOOL_API_KEY=
