{
  "type": "function",
  "function": {
    "name": "maintenance_knowledge_retriever",
    "description": "检索航空发动机维修知识库，返回带来源、分数和内容哈希的只读证据片段。覆盖发动机维修手册、机场处置流程和安全边界规定。",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500,
          "description": "待检索的维修知识问题或故障描述，应包含部件名称、异常现象和需要查找的内容"
        },
        "request_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "调用方提供的链路追踪 ID，未提供时自动生成"
        },
        "top_k": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 10,
          "description": "返回知识片段数量，建议 3 到 5"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "description": "可选知识分类过滤，可选值：engine_manual、airport_handbook、regulations"
        },
        "min_score": {
          "type": "number",
          "default": 0.0,
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "最小关键词匹配分数，建议从 0.05 开始"
        }
      },
      "required": ["query"]
    }
  }
}